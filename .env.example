# Disposable local application settings; no credentials required.
RACKOPS_REDIS_HOST=redis
RACKOPS_REDIS_PORT=6379
# Hosted evaluation is disabled until every value below is explicitly supplied.
# Use current prices for the exact account/model; never commit a real key.
OPENAI_API_KEY=
RACKOPS_LLM_MODEL=
RACKOPS_LLM_REASONING_EFFORT=none
RACKOPS_LLM_BUDGET_USD=
RACKOPS_LLM_INPUT_USD_PER_MILLION=
RACKOPS_LLM_OUTPUT_USD_PER_MILLION=
RACKOPS_LLM_MAX_ATTEMPTS=2
